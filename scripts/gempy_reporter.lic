=begin
Gempy live telemetry reporter, version 1.4.0. Requires Lich 5.11+.
;gempy_reporter --url=http://127.0.0.1:8080/api/telemetry/update --token=TOKEN
Settings are character-specific and separate from kmon/Saga settings.
=end
require 'net/http'
require 'json'
require 'uri'
require 'securerandom'
no_kill_all
no_pause_all
hide_me
silence_me

module GempyReporter
  VERSION = '1.4.0'.freeze
  AREAS = %w[nsys head neck chest abdomen back leftArm rightArm leftHand rightHand leftLeg rightLeg leftFoot rightFoot leftEye rightEye].freeze
  @settings = { 'url' => 'http://127.0.0.1:8080/api/telemetry/update', 'interval' => 3,
                'command_interval' => 120, 'enabled' => true }.merge(CharSettings[:gempy_reporter] || {})
  @reporter_id = SecureRandom.uuid
  @sequence = 0
  @experience = {}
  @bonuses = {}
  @stats = {}
  @skills = nil
  @resources = {}
  @wealth = {}
  @bank_report = nil
  @profile_observed = {}
  @availability = {}
  @started = Time.now
  @samples = []
  @last_error = Time.at(0)
  @hook_id = "gempy_reporter_#{@reporter_id}"
  @login_rewards = {}
  @checkin_context = begin
    value = JSON.parse(ENV.fetch('GEMPY_CHECKIN_CONTEXT', 'null'))
    value if value.is_a?(Hash) && value['capture_id'].to_s.match?(/\A[a-f0-9]{48}\z/)
  rescue JSON::ParserError
    nil
  end
  @checkin_ready = false

  def self.safe
    yield
  rescue StandardError
    nil
  end

  def self.available?(value)
    return value.values.any? { |item| available?(item) } if value.is_a?(Hash)
    return true if value.is_a?(Array) # A successfully read empty effect list is known empty.
    !value.nil?
  end

  def self.tutelage_state(state, source)
    if @bonuses[:fashlonae_state] == 'unavailable' && %w[active inactive expended].include?(state)
      @bonuses.delete(:fashlonae_days_remaining)
      @bonuses.delete(:fashlonae_days_observed_at)
    end
    @bonuses[:fashlonae_state] = state
    @bonuses[:fashlonae_source] = source
    @bonuses[:fashlonae_observed_at] = Time.now.to_i
    if state == 'unavailable'
      @bonuses[:fashlonae_days_remaining] = 0
      @bonuses[:fashlonae_days_observed_at] = Time.now.to_i
    end
  end

  def self.section(name)
    result = yield
    @availability[name] = { available: available?(result), collected_at: Time.now.to_i }
    result
  rescue StandardError
    @availability[name] = { available: false, collected_at: Time.now.to_i }
    nil
  end

  def self.configure
    Script.current.vars[1..-1].each do |arg|
      case arg
      when /\A--(url|token|legacy-url)=(.+)\z/
        @settings[Regexp.last_match(1)] = Regexp.last_match(2)
      when /\A--(interval|command-interval)=(\d+)\z/
        key = Regexp.last_match(1).tr('-', '_')
        @settings[key] = [Regexp.last_match(2).to_i, key == 'interval' ? 2 : 30].max
      when '--enable' then @settings['enabled'] = true
      when '--disable' then @settings['enabled'] = false
      when '--clear-legacy' then @settings.delete('legacy-url')
      when '--help'
        respond 'Gempy: --url=URL --token=TOKEN --interval=3 --command-interval=120 --enable --disable'
        respond 'Optional migration: --legacy-url=OLD_ENDPOINT; --clear-legacy stops dual reporting.'
        exit
      end
    end
    CharSettings[:gempy_reporter] = @settings
    raise 'Configure --token using the Gempy Settings reporter token first.' if @settings['enabled'] && @settings['token'].to_s.empty?
  end

  # Observe native XML and command output without suppressing or modifying game traffic.
  def self.observe(line)
    now = Time.now.to_i
    original_line = line
    plain = line.gsub(/<[^>]*>/, '')
    if plain =~ /^\s*Current Login Streak:\s*(\d+) days?/
      streak = Regexp.last_match(1).to_i
      @login_rewards = { streak: streak, observed_at: now } if (1..30).cover?(streak)
    end
    # These layouts match INFO FULL, SKILL and RESOURCE in the installed Lich parser.
    if plain =~ /^\s*(\w+)\s+\((?:STR|CON|DEX|AGI|DIS|AUR|LOG|INT|WIS|INF)\):(?:\s+(\d+)\s+\((-?\d+)\)\s+\.{3})?\s+(\d+)\s+\((-?\d+)\)\s+\.{3}\s+(\d+)\s+\((-?\d+)\)/
      name, base, base_bonus, value, bonus, enhanced, enhanced_bonus = Regexp.last_match.captures
      @stats[name.downcase.to_sym] = { value: value.to_i, bonus: bonus.to_i,
        base_value: base && base.to_i, base_bonus: base_bonus && base_bonus.to_i,
        enhanced_value: enhanced.to_i, enhanced_bonus: enhanced_bonus.to_i }
      @profile_observed['stats'] = now
    end
    if plain =~ /^\s*\S+\s+\(at level \d+\), your current skill bonuses and ranks/
      @pending_skills = {}
    elsif @pending_skills && plain =~ /^\s+([A-Za-z][A-Za-z\s\-']+?)\.+\|\s+(\d+)\s+(\d+)\s*$/
      name, bonus, ranks = Regexp.last_match.captures
      key = name.strip.downcase.gsub(/[^a-z0-9]+/, '_').to_sym
      @pending_skills[key] = { ranks: ranks.to_i, bonus: bonus.to_i, category: 'skill' }
    elsif @pending_skills && plain =~ /^\s+([A-Za-z][A-Za-z\s\-']+?)\.+\|\s+(\d+)\s*$/
      name, ranks = Regexp.last_match.captures
      key = name.strip.downcase.gsub(/[^a-z0-9]+/, '_').to_sym
      @pending_skills[key] = { ranks: ranks.to_i, bonus: nil, category: 'spell_research' }
    elsif @pending_skills && plain =~ /^Training Points: \d+ Phy \d+ Mnt/
      @skills = @pending_skills
      @pending_skills = nil
      @profile_observed['skills'] = now
    end
    if plain =~ /^(Essence|Necrotic Energy|Lore Knowledge|Motes of Tranquility|Devotion|Nature's Grace|Grit|Luck Inspiration|Guile|Vitality):\s*([\d,]+)\/([\d,]+)\s+\(Weekly\)\s+([\d,]+)\/([\d,]+)\s+\(Total\)/
      kind, weekly, cap_weekly, total, cap_total = Regexp.last_match.captures
      @resources.merge!({ type: kind, weekly: weekly.delete(',').to_i, total: total.delete(',').to_i,
                     max_weekly: cap_weekly.delete(',').to_i, max_total: cap_total.delete(',').to_i,
                     observed_at: now })
      @profile_observed['resources'] = now
    end
    # Formats mirror Lich's Infomon suffused/LTE and Bank ACCOUNT_TOTAL parsers.
    if plain =~ /^Suffused (?:Essence|Necrotic Energy|Lore Knowledge|Motes of Tranquility|Devotion|Nature's Grace|Grit|Luck Inspiration|Guile|Vitality):\s*([\d,]+)\s*$/
      @resources[:suffused] = Regexp.last_match(1).delete(',').to_i
      @resources[:suffused_observed_at] = now
      @profile_observed['resources'] = now
    end
    if plain =~ /^\s*Long-Term Exp:\s*[\d,]+\s+Deeds:\s*(\d+)\s*$/
      @wealth[:deeds] = Regexp.last_match(1).to_i
      @wealth[:deeds_observed_at] = now
    end
    # A total is meaningful only inside an all-bank listing completed by a prompt.
    @bank_report = nil if @bank_report && now - @bank_report[:started] > 5
    if plain.include?('You currently have the following amounts on deposit')
      @bank_report = { started: now }
    elsif @bank_report && plain =~ /^\s+Total:\s*([\d,]+)\s*$/
      @bank_report[:total] = Regexp.last_match(1).delete(',').to_i
    end
    @bank_report = nil if plain.match?(/you don't have access/i)
    if @bank_report && original_line.match?(/<prompt\b/)
      unless @bank_report[:total].nil?
        @wealth[:bank_balance] = @bank_report[:total]
        @wealth[:bank_balance_observed_at] = now
      end
      @bank_report = nil
    end
    if line.include?("dialogData id='expr'") || line.include?('dialogData id="expr"')
      { 'exp' => :lifetime_exp, 'ascension_exp' => :ascension_exp, 'field_exp' => :field_experience_current,
        'max_field_exp' => :field_experience_max, 'until_next' => :exp_to_next_tp }.each do |attr, key|
        @experience[key] = Regexp.last_match(1).to_i if line =~ /\b#{attr}=['"](\d+)['"]/
      end
      # Match Saga's native weekly state: 0 available, 1 expended, 2 active.
      mind_bar = line[/<progressBar\b(?=[^>]*\bid=['"]mindState['"])[^>]*>/]
      if (mind_bar || line) =~ /\b(?:fashlonae|tutelage)=['"](\d+)['"]/
        raw = Regexp.last_match(1).to_i
        @bonuses[:fashlonae_raw] = raw
        tutelage_state({ 0 => 'inactive', 1 => 'expended', 2 => 'active' }.fetch(raw, 'unknown'), 'native_dialog')
      elsif mind_bar
        @bonuses.delete(:fashlonae_raw)
        tutelage_state('unavailable', 'native_dialog')
      end
      if @native_sample && now - @native_sample[0] <= 10 && @experience[:lifetime_exp] && @experience[:ascension_exp]
        gain = @experience[:lifetime_exp] - @native_sample[1] + @experience[:ascension_exp] - @native_sample[2]
        if gain > 0
          @last_pulse = gain
          @best_pulse = [@best_pulse || 0, gain].max
        end
      end
      @native_sample = [now, @experience[:lifetime_exp], @experience[:ascension_exp]] if @experience[:lifetime_exp] && @experience[:ascension_exp]
      @experience[:observed_at] = now
    end
    line = plain
    { /\bExperience:\s*([\d,]+)/ => :lifetime_exp, /Ascension Exp:\s*([\d,]+)/ => :ascension_exp,
      /Total Exp:\s*([\d,]+)/ => :total_exp, /Long-Term Exp:\s*([\d,]+)/ => :long_term_exp,
      /Exp to next TP:\s*([\d,]+)/ => :exp_to_next_tp, /Exp to next ATP:\s*([\d,]+)/ => :exp_to_next_atp,
      /\bATPs:\s*([\d,]+)/ => :total_atps }.each do |pattern, key|
      if line =~ pattern
        @experience[key] = Regexp.last_match(1).delete(',').to_i
        @experience[:observed_at] = now
      end
    end
    if line =~ %r{PTPs/MTPs:\s*(\d+)/(\d+)}
      @experience[:physical_training_points], @experience[:mental_training_points] = Regexp.last_match.captures.map(&:to_i)
    end
    if line =~ /Your recent adventures echo powerfully in your mind|You feel a strange sense of serenity/
      @bonuses[:rpa] = true
      @bonuses[:rpa_observed_at] = now
    end
    tutelage_state('active', 'game_message') if line.include?('You feel a heightened understanding of events around you.')
    tutelage_state('inactive', 'game_message') if line.include?('The feeling of heightened understanding departs') && !%w[expended unavailable].include?(@bonuses[:fashlonae_state])
    tutelage_state('inactive', 'lumnis_info') if line.include?("not presently receiving Fash'lo'nae's Tutelage") && !%w[active expended unavailable].include?(@bonuses[:fashlonae_state])
    if line =~ /receiving Fash'lo'nae's Tutelage with ([\d,]+) day/
      days = Regexp.last_match(1).delete(',').to_i
      # This line confirms a redeemed benefit, not an active XP multiplier.
      tutelage_state('inactive', 'lumnis_info') unless %w[active inactive expended].include?(@bonuses[:fashlonae_state])
      @bonuses[:fashlonae_days_remaining] = days
      @bonuses[:fashlonae_days_observed_at] = now
    end
    if line =~ /Your Gift of Lumnis|You have .*points? of .*experience|It is scheduled to refresh|restart as soon as you absorb experience|Because your account is free,/
      @bonuses[:lumnis_text] = line.gsub(/<[^>]*>/, '').strip
      @bonuses[:observed_at] = now
      if line =~ /([\d,]+)\s+points? of (tripled|doubled|quadrupled|quintupled) experience/
        @bonuses[:lumnis_points_remaining] = Regexp.last_match(1).delete(',').to_i
        @bonuses[:lumnis_stage] = { 'doubled' => 2, 'tripled' => 3, 'quadrupled' => 4, 'quintupled' => 5 }[Regexp.last_match(2)]
      end
      reset = line.split('It is scheduled to refresh', 2)[1]
      if reset
        seconds = reset[/(\d+)\s*days?/, 1].to_i * 86400 + reset[/(\d+)\s*hours?/, 1].to_i * 3600 + reset[/(\d+)\s*minutes?/, 1].to_i * 60
        @bonuses[:lumnis_reset_at] = now + seconds if seconds > 0
      end
      @bonuses[:lumnis_stage] = 'ready' if line.include?('restart as soon as you absorb experience')
      @bonuses[:lumnis_stage] = 'expired' if line.include?('Your Gift of Lumnis has expired for this week')
      @bonuses[:lumnis_stage] = 'unavailable' if line.include?('Because your account is free,')
      if %w[ready expired unavailable].include?(@bonuses[:lumnis_stage])
        @bonuses.delete(:lumnis_points_remaining)
      end
    end
    if line =~ /You have made ([\d,]+) recent donations to the Temple of Lumnis/
      @bonuses[:lumnis_donations] = Regexp.last_match(1).delete(',').to_i
      @bonuses[:donations_observed_at] = now
    elsif line.include?('You have not made any recent donations to the Temple of Lumnis')
      @bonuses[:lumnis_donations] = 0
      @bonuses[:donations_observed_at] = now
    end
    if line =~ /You currently are enlightened, earning \+50% base experience until (.+?) elven time standard/
      @bonuses[:exp_scroll_expires_elven] = Regexp.last_match(1)
    end
    original_line
  rescue StandardError
    original_line || line
  end

  def self.collect
    @sequence += 1
    data = { schema_version: 1, reporter_id: @reporter_id, sequence: @sequence, pid: Process.pid,
             realm: XMLData.game, collected_at: Time.now.to_i }
    data[:process_start] = safe { File.read('/proc/self/stat').split(') ', 2)[1].split[19].to_i }
    data.delete(:process_start) if data[:process_start].nil?
    data[:character] = section('character') do
      { name: Char.name, level: Stats.level, profession: Stats.prof,
        race: safe { Stats.race }, gender: safe { Stats.gender } }
    end
    data[:stats] = section('stats') { @stats.empty? ? nil : @stats.transform_values(&:dup) }
    data[:skills] = section('skills') { @skills && @skills.transform_values(&:dup) }
    data[:vitals] = section('vitals') do
      %i[health mana stamina spirit].to_h do |kind|
        [kind, { current: safe { Char.send(kind) }, max: safe { Char.send("max_#{kind}") }, percent: safe { Char.send("percent_#{kind}") } }]
      end
    end
    data[:status] = section('status') do
      { stance: 'stance', mindstate: 'mind', encumbrance: 'encumbrance' }.to_h do |key, prefix|
        [key, { text: safe { XMLData.send("#{prefix}_text") }, value: safe { XMLData.send("#{prefix}_value") } }]
      end
    end
    data[:location] = section('location') { room = Room.current; room && { room_id: room.id, room_title: room.title } }
    data[:injuries] = section('injuries') do
      { wounds: AREAS.to_h { |area| [area, safe { Wounds.send(area) }] }, scars: AREAS.to_h { |area| [area, safe { Scars.send(area) }] } }
    end
    data[:effects] = section('effects') do
      %i[spells buffs debuffs cooldowns].to_h do |kind|
        effects = safe do
          Effects.const_get(kind.to_s.capitalize).to_h.filter_map do |name, expiry|
            next if name.is_a?(Integer) || expiry <= Time.now
            { name: name, end_time: expiry.to_i, remaining_seconds: (expiry - Time.now).to_i }
          end.sort_by { |effect| effect[:remaining_seconds] }
        end
        [kind, effects]
      end
    end
    data[:resources] = section('resources') do
      resource = @resources.dup
      resource[:voln_favor] = safe { Society.status =~ /Voln/ ? Resources.voln_favor : nil }
      resource
    end
    data[:wealth] = section('wealth') { @wealth.dup }
    data[:experience] = section('experience') do
      exp = @experience.dup
      exp[:lifetime_exp] = safe { Stats.exp } || exp[:lifetime_exp]
      exp[:field_experience_current] = safe { Experience.fxp_current }
      exp[:field_experience_max] = safe { Experience.fxp_max }
      exp[:ascension_exp] = safe { Experience.axp } || exp[:ascension_exp]
      exp[:ascension_experience] = exp[:ascension_exp]
      exp[:next_level_percent] = safe { XMLData.next_level_value }
      text = safe { XMLData.next_level_text }
      exp[:experience_to_next_level] = text && text[/([\d,]+) (?:experience|until next level)/, 1]&.delete(',')&.to_i
      # Lifetime counters survive level transitions; do not infer XP from a wrapping progress bar.
      total = exp[:lifetime_exp] && exp[:ascension_exp] && exp[:lifetime_exp] + exp[:ascension_exp]
      if total
        changed = @samples.empty? || @samples.last[1] != total
        if !@samples.empty? && total < @samples.last[1]
          @samples.clear
          @baseline = total
          @normal_baseline = exp[:lifetime_exp]
          @ascension_baseline = exp[:ascension_exp]
          @started = Time.now
        end
        @samples << [Time.now.to_f, total, exp[:ascension_exp]] if changed
        @baseline ||= total
        @samples.shift while @samples.length > 1 && @samples[1][0] < Time.now.to_f - 3600
        elapsed_hours = [(Time.now - @started) / 3600, 1.0 / 60].max
        @normal_baseline ||= exp[:lifetime_exp]
        @ascension_baseline ||= exp[:ascension_exp]
        exp[:normal_hourly_rate] = [((exp[:lifetime_exp] - @normal_baseline) / elapsed_hours).round, 0].max
        exp[:ascension_hourly_rate] = [((exp[:ascension_exp] - @ascension_baseline) / elapsed_hours).round, 0].max
        exp[:hourly_rate] = exp[:normal_hourly_rate] + exp[:ascension_hourly_rate]
        exp[:last_hour_gain] = [total - @samples.first[1], 0].max
        pulse = @samples.length > 1 ? total - @samples[-2][1] : nil
        exp[:gain_since_previous_sample] = pulse if changed && pulse && pulse >= 0
        exp[:last_pulse] = @last_pulse
        exp[:best_pulse] = @best_pulse
        exp[:percent_capped] = (exp[:lifetime_exp].fdiv(7_572_500) * 100).round(2)
        rate = exp[:normal_hourly_rate]
        exp[:eta_next_tp_seconds] = (exp[:exp_to_next_tp].fdiv(rate) * 3600).round if exp[:exp_to_next_tp] && rate > 0
        exp[:eta_next_level_seconds] = (exp[:experience_to_next_level].fdiv(rate) * 3600).round if exp[:experience_to_next_level] && rate > 0
        asc_rate = exp[:ascension_hourly_rate]
        exp[:eta_next_atp_seconds] = (exp[:exp_to_next_atp].fdiv(asc_rate) * 3600).round if exp[:exp_to_next_atp] && asc_rate > 0
      end
      exp
    end
    data[:bonuses] = section('bonuses') { @bonuses.dup }
    data[:daily_tracking] = section('daily_tracking') do
      { xp_today: safe { UserVars.uberbar_xp_per_day }, xp_history: safe { UserVars.uberbar_xp_history },
        silver_today: safe { defined?(Ledger) ? Ledger::Character.daily : UserVars.bank_silver_per_day },
        bounty_points: safe { defined?(BountyHUD) ? BountyHUD.metadata.dig(:earned, :recent) : UserVars.bank_bounty_per_day } }
    end
    data[:login_rewards] = @login_rewards.dup
    data[:checkin] = @checkin_receipt if @checkin_receipt
    data[:metadata] = { timestamp: Time.now.to_i, script_version: VERSION, update_interval: @settings['interval'], availability: @availability.dup }
    @profile_observed.each do |name, observed|
      data[:metadata][:availability][name] = { available: true, collected_at: observed }
    end
    data
  end

  def self.send_to(url, data, token: nil)
    uri = URI.parse(url)
    raise 'Reporter URL must use http or https' unless %w[http https].include?(uri.scheme)
    http = Net::HTTP.new(uri.host, uri.port)
    http.use_ssl = uri.scheme == 'https'
    http.open_timeout = 3
    http.read_timeout = 3
    http.write_timeout = 3 if http.respond_to?(:write_timeout=)
    request = Net::HTTP::Post.new(uri.request_uri)
    request['Content-Type'] = 'application/json'
    request['Authorization'] = "Bearer #{token}" if token
    request.body = JSON.generate(data)
    response = http.request(request)
    raise "HTTP #{response.code}" unless response.is_a?(Net::HTTPSuccess)
    JSON.parse(response.body.to_s.empty? ? '{}' : response.body)
  end

  # Call this at the successful end of the character's finite login script.
  # Merely sleeping, or seeing a script disappear, is not a success signal.
  def self.checkin_ready!
    @checkin_ready = true
  end

  def self.accept_checkin_response(response)
    return unless @checkin_context && response.is_a?(Hash)
    if response['checkin_release'] == @checkin_context['capture_id']
      @checkin_context = @checkin_request = @checkin_receipt = nil
      return
    end
    request = response['checkin_request']
    return unless request.is_a?(Hash) && request['capture_id'] == @checkin_context['capture_id']
    return if @checkin_request # An identical retransmission must not reset progress.
    @checkin_request = request
    @checkin_index = 0
    @checkin_fields = {}
    @checkin_receipt = { capture_id: request['capture_id'], phase: 'startup', startup_ready: false }
  end

  def self.checkin_step
    return false unless @checkin_request
    return true if @checkin_receipt[:phase] == 'captured'
    ready = @checkin_ready || @checkin_context['startup_mode'] == 'none'
    return false unless ready
    @checkin_receipt.merge!(startup_ready: true, phase: 'capturing')
    commands = ['info full', 'skill', 'lumnis info', 'resource', 'experience', 'boost info', 'bank account']
    command = commands[@checkin_index]
    lines = Array(refresh_command(command))
    plain = lines.map { |line| line.gsub(/<[^>]*>/, '') }.join("\n")
    # Only this command's complete response can certify an observation. Cached
    # Char/Stats values and old downstream observations never advance the barrier.
    finished = lines.any? { |line| line.match?(/<prompt\b/) }
    now = Time.now.to_i
    mark = lambda do |field, matched|
      @checkin_fields[field] = { status: finished && matched ? 'captured' : 'unavailable', observed_at: now }
    end
    case command
    when 'info full'
      mark.call('character', plain.match?(/^\s*Name:\s*\S+/) && !safe { Char.name }.to_s.empty?)
      mark.call('stats', plain.scan(/\((?:STR|CON|DEX|AGI|DIS|AUR|LOG|INT|WIS|INF)\):/).length == 10)
      @checkin_receipt[:presence_at] = now if @checkin_fields['character'][:status] == 'captured'
    when 'skill'
      mark.call('skills', plain.match?(/your current skill bonuses and ranks/) && plain.match?(/^Training Points:/))
    when 'lumnis info'
      mark.call('bonuses', plain.match?(/Your Gift of Lumnis|You have .*points? of .*experience|Because your account is free,/))
    when 'resource'
      mark.call('resources', plain.match?(/:\s*[\d,]+\/[\d,]+\s+\(Weekly\)\s+[\d,]+\/[\d,]+\s+\(Total\)/))
    when 'experience'
      mark.call('experience', plain.match?(/\bExperience:\s*[\d,]+/))
      mark.call('deeds', plain.match?(/Long-Term Exp:\s*[\d,]+\s+Deeds:\s*\d+/))
    when 'boost info'
      mark.call('reward_info', plain.match?(/Current Login Streak:\s*\d+ days?/) && @login_rewards[:observed_at] == now)
      @checkin_receipt[:streak] = @login_rewards[:streak] if @checkin_fields['reward_info'][:status] == 'captured'
    when 'bank account'
      mark.call('bank', !@wealth[:bank_balance].nil? && @wealth[:bank_balance_observed_at] == now && !lines.empty?)
    end
    @checkin_index += 1
    @checkin_receipt[:fields] = @checkin_fields.dup
    @checkin_receipt[:phase] = 'captured' if @checkin_index >= commands.length
    true
  rescue StandardError
    # A capture failure remains visible and is cleaned up by the coordinator's
    # deadline; do not kill the reporter or falsely acknowledge a complete batch.
    @checkin_receipt[:phase] = 'capturing' if @checkin_receipt
    true
  end

  # Suppress only the requested report, bounded by its first line and prompt.
  # Parse the captured lines explicitly so collection does not depend on hook order.
  def self.refresh_command(command)
    # Remote BANK ACCOUNT can consume a bank-runner use; query only at a bank.
    if command == 'bank account'
      at_bank = safe { Room.current&.tags.to_a.include?('bank') || XMLData.room_title == '[Pinefar, Depository]' }
      return unless at_bank
    end
    start = if %w[skill].include?(command) || command == 'info full'
              /<output class=["']mono["']\s*\/>|<a exist=|^Name:|\(at level \d+\), your current skill/
            elsif command == 'lumnis info'
              /<output class=["']mono["']\s*\/>|Your Gift of Lumnis|You have .*points? of .*experience|Because your account is free,/
            elsif command == 'bank account'
              /<output class=["']mono["']\s*\/>|You currently have the following amounts on deposit|You currently have an account|you don't have access/i
             elsif command == 'boost info'
              /<output class=["']mono["']\s*\/>|Login Rewards information|Current Login Streak:/
            else
              /<output class=["']mono["']\s*\/>|^Health: |^Experience: /
            end
    lines = Lich::Util.quiet_command_xml(command, start, /<prompt\b/, true, 5)
    Array(lines).each { |line| observe(line) }
  end

  def self.main
    configure
    return unless @settings['enabled']
    DownstreamHook.add(@hook_id, proc { |line| observe(line) })
    before_dying { DownstreamHook.remove(@hook_id); CharSettings[:gempy_reporter] = @settings }
    echo 'Gempy reporter started; configuration is stored per character.'
    failures = 0
    next_command = Time.at(0)
    command_index = 0
    loop do
      begin
        checking_in = checkin_step
        if !checking_in && !@checkin_context && Time.now >= next_command
          # One bounded command per turn; profiles refresh less often than live monitoring.
          commands = ['info full', 'skill', 'lumnis info', 'resource', 'experience', 'lumnis info', 'resource', 'bank account']
          refresh_command(commands[command_index % commands.length])
          command_index += 1
          next_command = Time.now + (command_index < commands.length ? @settings['interval'] : @settings['command_interval'])
        end
        data = collect
        reply = send_to(@settings['url'], data, token: @settings['token'])
        accept_checkin_response(reply)
        if @settings['legacy-url']
          safe { send_to(@settings['legacy-url'], data) }
        end
        failures = 0
      rescue StandardError => error
        failures += 1
        if Time.now - @last_error > 60
          echo "Gempy reporter: #{error.class}: #{error.message}. Retrying; game session continues."
          @last_error = Time.now
        end
      end
      sleep [@settings['interval'] * (2**[failures, 4].min), 60].min
    end
  ensure
    DownstreamHook.remove(@hook_id) rescue nil
  end
end
GempyReporter.main
