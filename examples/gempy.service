# Copy to ~/.config/systemd/user/gempy.service after replacing both paths.
# Set the password with ./run.sh --set-password as this user before starting.
[Unit]
Description=Gempy web session manager
After=network.target

[Service]
Type=simple
WorkingDirectory=/absolute/path/to/gempy
ExecStart=/absolute/path/to/gempy/run.sh --web --host 0.0.0.0 --port 8080
Restart=on-failure
RestartSec=5
# Stop only Gempy; Lich and Vellum must survive daemon restarts.
KillMode=process
UMask=0077

[Install]
WantedBy=default.target
